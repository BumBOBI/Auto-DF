            bottom: 25px;
            right: 20px;
            z-index: 999999;
            background: linear-gradient(135deg, var(--df-primary), #d84315);
            color: #fff;
            padding: 12px 18px;
            border-radius: 50px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.5px;
            box-shadow: 0 6px 20px rgba(255, 87, 34, 0.45);
            border: 1px solid rgba(255,255,255,0.2);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            user-select: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        #df-floating-trigger:active {
            transform: scale(0.95);
        }

        #df-dashboard-v3 {
            position: fixed;
            bottom: 85px;
            right: 15px;
            width: 350px;
            max-width: 92vw;
            background: var(--df-bg);
            border: 1px solid var(--df-border);
            border-radius: 14px;
            box-shadow: 0 16px 45px rgba(0, 0, 0, 0.8);
            z-index: 999999;
            display: none;
            flex-direction: column;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: var(--df-text);
        }

        .df-header {
            background: var(--df-card);
            padding: 12px 16px;
            border-bottom: 1px solid var(--df-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .df-title {
            font-weight: 800;
            font-size: 13px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .df-badge-ver {
            background: rgba(255,87,34,0.15);
            color: var(--df-primary);
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: bold;
        }

        .df-body {
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .df-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
        }
        .df-stat-card {
            background: var(--df-card);
            border: 1px solid var(--df-border);
            border-radius: 8px;
            padding: 8px 4px;
            text-align: center;
        }
        .df-stat-val {
            font-size: 15px;
            font-weight: 800;
            line-height: 1.2;
        }
        .df-stat-lbl {
            font-size: 9px;
            text-transform: uppercase;
            color: var(--df-muted);
            margin-top: 2px;
        }

        .df-progress-wrap {
            height: 6px;
            background: #1e2230;
            border-radius: 3px;
            overflow: hidden;
            position: relative;
        }
        .df-progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--df-primary), var(--df-success));
            transition: width 0.25s ease;
        }

        .df-setting-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: var(--df-muted);
            background: var(--df-card);
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid var(--df-border);
        }
        .df-select {
            background: #0f1118;
            color: var(--df-warn);
            border: 1px solid #363b50;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: 12px;
            font-weight: bold;
            outline: none;
        }

        #df-code-input {
            width: 100%;
            height: 75px;
            background: #0d0e14;
            border: 1px solid var(--df-border);
            border-radius: 8px;
            padding: 8px;
            font-size: 12px;
            color: #fff;
            box-sizing: border-box;
            resize: none;
            font-family: monospace;
        }
        #df-code-input:focus {
            border-color: var(--df-primary);
            outline: none;
        }

        .df-actions {
            display: flex;
            gap: 6px;
        }
        .df-btn {
            border: none;
            border-radius: 6px;
            padding: 10px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .df-btn:active { opacity: 0.8; }
        .df-btn-primary {
            flex: 2;
            background: var(--df-primary);
            color: white;
        }
        .df-btn-warn {
            flex: 1;
            background: #373b4d;
            color: var(--df-warn);
            display: none;
        }
        .df-btn-danger {
            flex: 1;
            background: #3e1b21;
            color: var(--df-danger);
            border: 1px solid rgba(255,82,82,0.3);
            display: none;
        }

        #df-logs-panel {
            background: #0b0c10;
            border: 1px solid var(--df-border);
            border-radius: 8px;
            height: 100px;
            overflow-y: auto;
            padding: 8px;
            font-size: 11px;
            font-family: monospace;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .df-log-entry {
            display: flex;
            gap: 6px;
            line-height: 1.3;
        }
        .df-log-time { color: #525970; }
        .df-log-txt { word-break: break-all; }
        .df-log-success { color: var(--df-success); }
        .df-log-warn { color: var(--df-warn); }
        .df-log-danger { color: var(--df-danger); }
        .df-log-info { color: var(--df-info); }
    `;

    if (typeof GM_addStyle !== "undefined") {
        GM_addStyle(styles);
    } else {
        const tag = document.createElement('style');
        tag.textContent = styles;
        document.head.appendChild(tag);
    }

    /* ==========================================================================
       3. DOM MOUNTING & UI SETUP
       ========================================================================== */
    const trigger = document.createElement('div');
    trigger.id = 'df-floating-trigger';
    trigger.innerHTML = `<span>⚡</span><span>DF TOOL 1.1</span>`;

    const dashboard = document.createElement('div');
    dashboard.id = 'df-dashboard-v3';
    dashboard.innerHTML = `
        <div class="df-header">
            <div class="df-title">
                <span>🎮 Delta Force Redeem</span>
                <span class="df-badge-ver">v3.1 Rebuild</span>
            </div>
            <span style="cursor:pointer; font-size:16px; color:#888;" id="df-btn-close">✕</span>
        </div>
        <div class="df-body">
            <div class="df-stats-grid">
                <div class="df-stat-card">
                    <div class="df-stat-val" id="stat-total" style="color: var(--df-info)">0</div>
                    <div class="df-stat-lbl">Tổng mã</div>
                </div>
                <div class="df-stat-card">
                    <div class="df-stat-val" id="stat-success" style="color: var(--df-success)">0</div>
                    <div class="df-stat-lbl">Thành công</div>
                </div>
                <div class="df-stat-card">
                    <div class="df-stat-val" id="stat-used" style="color: var(--df-warn)">0</div>
                    <div class="df-stat-lbl">Đã nhận</div>
                </div>
                <div class="df-stat-card">
                    <div class="df-stat-val" id="stat-invalid" style="color: var(--df-danger)">0</div>
                    <div class="df-stat-lbl">Lỗi/Hỏng</div>
                </div>
            </div>

            <div class="df-progress-wrap">
                <div class="df-progress-bar" id="df-progress-bar"></div>
            </div>

            <div class="df-setting-row">
                <span>Tốc độ thực thi:</span>
                <select id="df-speed-opt" class="df-select">
                    <option value="0.75">x0.75 (An toàn)</option>
                    <option value="1.0" selected>x1.0 (Chuẩn)</option>
                    <option value="2.0">x2.0 (Nhanh)</option>
                    <option value="3.0">x3.0 (Siêu tốc)</option>
                    <option value="4.0">x4.0 (Cực hạn)</option>
                </select>
            </div>

            <textarea id="df-code-input" placeholder="Dán danh sách mã code... (Tự động lọc trùng)"></textarea>

            <div class="df-actions">
                <button class="df-btn df-btn-primary" id="btn-start">Bắt đầu chạy</button>
                <button class="df-btn df-btn-warn" id="btn-pause">Tạm dừng</button>
                <button class="df-btn df-btn-danger" id="btn-stop">Dừng hẳn</button>
            </div>

            <div id="df-logs-panel"></div>
        </div>
    `;

    document.body.appendChild(trigger);
    document.body.appendChild(dashboard);

    /* ==========================================================================
       4. UI HELPERS & LOGGING
       ========================================================================== */
    const logsContainer = document.getElementById('df-logs-panel');
    function log(message, type = 'info') {
        const entry = document.createElement('div');
        entry.className = 'df-log-entry';
        const now = new Date();
        const timeStr = `${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
        entry.innerHTML = `<span class="df-log-time">[${timeStr}]</span><span class="df-log-txt df-log-${type}">${message}</span>`;
        logsContainer.appendChild(entry);
        logsContainer.scrollTop = logsContainer.scrollHeight;
    }

    function updateStatsUI() {
        document.getElementById('stat-total').innerText = State.stats.total;
        document.getElementById('stat-success').innerText = State.stats.success;
        document.getElementById('stat-used').innerText = State.stats.used;
        document.getElementById('stat-invalid').innerText = State.stats.invalid;

        const progressPercent = State.stats.total > 0
            ? Math.round((State.currentIndex / State.stats.total) * 100)
            : 0;
        document.getElementById('df-progress-bar').style.width = `${progressPercent}%`;
    }

    trigger.addEventListener('click', () => {
        dashboard.style.display = (dashboard.style.display === 'flex' ? 'none' : 'flex');
    });
    document.getElementById('df-btn-close').addEventListener('click', () => {
        dashboard.style.display = 'none';
    });

    /* ==========================================================================
       5. CORE REDEEM ENGINE (Rebuild v3.1 Engine)
       ========================================================================== */
    const sleep = (ms) => new Promise(r => setTimeout(r, ms));

    // Kích hoạt mô phỏng gõ chữ chuẩn DOM InputEvent
    function injectInputValue(inputEl, value) {
        inputEl.focus();
        const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
        nativeSetter.call(inputEl, value);
        inputEl.dispatchEvent(new Event('input', { bubbles: true }));
        inputEl.dispatchEvent(new Event('change', { bubbles: true }));
        inputEl.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
    }

    function locateInputTarget() {
        const list = Array.from(document.querySelectorAll('input[type="text"], input:not([type])'))
            .filter(el => !dashboard.contains(el) && el.offsetParent !== null);

        let target = list.find(el => {
            const str = (el.placeholder + ' ' + el.id + ' ' + el.name + ' ' + el.className).toLowerCase();
            return str.includes('cdk') || str.includes('code') || str.includes('mã');
        });
        return target || (list.length > 0 ? list[list.length - 1] : null);
    }

    function locateSubmitTarget() {
        const buttons = Array.from(document.querySelectorAll('button, div[role="button"], a, [class*="btn"]'))
            .filter(b => !dashboard.contains(b) && b.offsetParent !== null);

        return buttons.find(b => {
            const txt = (b.innerText || b.textContent || '').trim().toLowerCase();
            return ['đổi', 'xác nhận', 'nhận', 'redeem', 'exchange', 'confirm'].includes(txt);
        });
    }

    // Cơ chế phân loại kết quả thông minh v3.1
    function classifyMessage(text) {
        const lower = text.toLowerCase();
        if (/thành công|chúc mừng|congratulations|success/i.test(lower)) {
            return { type: 'success', text };
        }
        if (/đã sử dụng|đã nhận|đã đổi|already/i.test(lower)) {
            return { type: 'used', text };
        }
        if (/hết hạn|không tồn tại|không hợp lệ|invalid|expired|sai mã/i.test(lower)) {
            return { type: 'invalid', text };
        }
        return { type: 'failed', text };
    }

    // Bộ lắng nghe phản hồi kết hợp MutationObserver
    function awaitModalResponse(speed) {
        return new Promise((resolve) => {
            const timeoutMs = Math.max(900, Math.round(4500 / speed));
            let resolved = false;

            const timer = setTimeout(() => {
                if (!resolved) {
                    resolved = true;
                    cleanup();
                    resolve({ type: 'failed', text: 'Quá thời gian phản hồi' });
                }
            }, timeoutMs);

            function checkExisting() {
                const popups = Array.from(document.querySelectorAll('.van-dialog, .van-toast, .modal, .dialog, .popup, div[role="dialog"], [class*="notice"], [class*="alert"]'))
                    .filter(el => !dashboard.contains(el) && el.getBoundingClientRect().width > 0 && window.getComputedStyle(el).display !== 'none');

                for (const p of popups) {
                    const txt = (p.innerText || p.textContent || "").trim();
                    if (txt.length > 2) {
                        const closeBtn = Array.from(p.querySelectorAll('button, div[role="button"], span'))
                            .find(b => /ok|xác nhận|confirm|đóng|close/i.test((b.innerText || '').toLowerCase()));
                        if (closeBtn) closeBtn.click();

                        const firstLine = txt.split('\n').filter(t => t.trim().length > 0)[0];
                        return classifyMessage(firstLine);
                    }
                }
                return null;
            }

            const observer = new MutationObserver(() => {
                const res = checkExisting();
                if (res && !resolved) {
                    resolved = true;
                    cleanup();
                    resolve(res);
                }
            });

            observer.observe(document.body, { childList: true, subtree: true });

            function cleanup() {
                clearTimeout(timer);
                observer.disconnect();
            }

            // Kiểm tra ngay trường hợp popup đã có sẵn
            const immediate = checkExisting();
            if (immediate && !resolved) {
                resolved = true;
                cleanup();
                resolve(immediate);
            }
        });
    }

    /* ==========================================================================
       6. QUEUE SCHEDULER & CONTROLLER
       ========================================================================== */
    async function startEngine() {
        const rawText = document.getElementById('df-code-input').value;
        const speed = parseFloat(document.getElementById('df-speed-opt').value) || 1.0;
        State.speedMultiplier = speed;

        // Lọc trùng và chuẩn hóa danh sách
        const lines = rawText.split('\n')
            .map(c => c.trim())
            .filter(c => c.length >= 4);

        const uniqueCodes = [...new Set(lines)];

        if (uniqueCodes.length === 0) {
            log('⚠️ Danh sách mã trống hoặc không hợp lệ!', 'warn');
            return;
        }

        const inputEl = locateInputTarget();
        if (!inputEl) {
            log('❌ Không tìm thấy ô nhập code! Hãy đăng nhập trước.', 'danger');
            return;
        }

        State.queue = uniqueCodes;
        State.currentIndex = 0;
        State.stats = { total: uniqueCodes.length, success: 0, used: 0, invalid: 0, failed: 0 };
        State.status = 'RUNNING';
        updateStatsUI();

        // Cập nhật trạng thái nút bấm
        document.getElementById('btn-start').style.display = 'none';
        document.getElementById('btn-pause').style.display = 'block';
        document.getElementById('btn-stop').style.display = 'block';
        log(`🚀 Khởi chạy engine v3.1: ${uniqueCodes.length} mã (Tốc độ x${speed})`, 'info');

        const inputDelay = Math.max(70, Math.round(550 / speed));
        const postDelay = Math.max(200, Math.round(1600 / speed));

        while (State.currentIndex < State.queue.length) {
            if (State.status === 'STOPPED') break;

            if (State.status === 'PAUSED') {
                await sleep(400);
                continue;
            }

            const currentCode = State.queue[State.currentIndex];
            log(`[${State.currentIndex + 1}/${State.queue.length}] Gửi: ${currentCode}...`, 'info');

            const currentInput = locateInputTarget();
            if (currentInput) {
                injectInputValue(currentInput, currentCode);
            }

            await sleep(inputDelay);

            const submitBtn = locateSubmitTarget();
            if (submitBtn) {
                submitBtn.click();
                const res = await awaitModalResponse(speed);

                if (res.type === 'success') {
                    State.stats.success++;
                    log(`✔ [${currentCode}]: ${res.text}`, 'success');
                } else if (res.type === 'used') {
                    State.stats.used++;
                    log(`⚡ [${currentCode}]: ${res.text}`, 'warn');
                } else if (res.type === 'invalid') {
                    State.stats.invalid++;
                    log(`✖ [${currentCode}]: ${res.text}`, 'danger');
                } else {
                    State.stats.failed++;
                    log(`⚠ [${currentCode}]: ${res.text}`, 'danger');
                }
            } else {
                State.stats.failed++;
                log(`✖ [${currentCode}]: Nút xác nhận bị khóa`, 'danger');
            }

            State.currentIndex++;
            updateStatsUI();

            await sleep(postDelay);
        }

        log(`🏁 Tiến trình kết thúc! Thành công: ${State.stats.success} | Đã dùng: ${State.stats.used} | Hỏng: ${State.stats.invalid}`, 'success');
        resetControls();
    }

    function resetControls() {
        State.status = 'IDLE';
        document.getElementById('btn-start').style.display = 'block';
        document.getElementById('btn-start').innerText = 'Chạy lại';
        document.getElementById('btn-pause').style.display = 'none';
        document.getElementById('btn-stop').style.display = 'none';
    }

    document.getElementById('btn-start').addEventListener('click', startEngine);

    document.getElementById('btn-pause').addEventListener('click', () => {
        if (State.status === 'RUNNING') {
            State.status = 'PAUSED';
            document.getElementById('btn-pause').innerText = 'Tiếp tục';
            log('⏸ Đã tạm dừng tiến trình', 'warn');
        } else if (State.status === 'PAUSED') {
            State.status = 'RUNNING';
            document.getElementById('btn-pause').innerText = 'Tạm dừng';
            log('▶ Tiếp tục tiến trình', 'info');
        }
    });

    document.getElementById('btn-stop').addEventListener('click', () => {
        State.status = 'STOPPED';
        log('⏹ Đã hủy tiến trình', 'danger');
        resetControls();
    });

})();
