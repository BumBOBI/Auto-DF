    function looksLikeCode(token) {
        return token.length >= MIN_CODE_LEN && token.length <= MAX_CODE_LEN && /[A-Za-z]/.test(token);
    }

    function fixLookalikes(token) {
        const upperOnly = !/[a-z]/.test(token);
        let out = '';
        for (const ch of token) {
            if (/[A-Za-z0-9_-]/.test(ch)) out += ch;
            else if (LOOKALIKES[ch]) out += upperOnly ? LOOKALIKES[ch].toUpperCase() : LOOKALIKES[ch];
            else return null;
        }
        return out;
    }

    function parseCodes(text) {
        const codes = [];
        const ignored = [];
        const suspicious = [];
        const seen = new Set();
        let duplicates = 0;
        const rawText = String(text ?? '').normalize('NFKC');
        for (const raw of rawText.split(/[^\p{L}\p{N}_=.\-]+/u)) {
            if (!raw) continue;
            let token = raw;
            let delaySec = null;
            const eqIdx = raw.indexOf('=');
            if (eqIdx > 0) {
                const left = raw.slice(0, eqIdx).replace(/[-_]+$/g, '');
                const right = raw.slice(eqIdx + 1);
                if (/^\d+(\.\d+)?$/.test(right)) {
                    const n = Number(right);
                    if (n >= 0.5 && n <= 60) delaySec = n;
                    token = left;
                }
            }
            token = token.replace(/^[-_]+|[-_]+$/g, '');
            if (!token) continue;
            if (/^[A-Za-z0-9_-]+$/.test(token)) {
                if (!looksLikeCode(token)) ignored.push(token);
                else if (seen.has(token)) duplicates += 1;
                else {
                    seen.add(token);
                    codes.push({ code: token, delaySec });
                }
                continue;
            }
            const suggestion = fixLookalikes(token);
            if (suggestion && /[A-Za-z0-9]/.test(token) && looksLikeCode(suggestion)) {
                suspicious.push({ token, suggestion, delaySec });
            } else ignored.push(token);
        }
        return { codes, duplicates, ignored, suspicious };
    }

    function previewParse() {
        const parsed = parseCodes($('df-code-input').value);
        lastSuspicious = parsed.suspicious;
        const defaultDelay = Number($('df-delay-range').value) || DELAY.default;
        const etaSec = parsed.codes.reduce((sum, item, i) => {
            const d = item.delaySec != null ? item.delaySec : defaultDelay;
            return sum + 1.2 + (i === 0 ? 0 : d);
        }, 0);
        const bits = [];
        bits.push(`${parsed.codes.length} code hợp lệ`);
        if (parsed.duplicates) bits.push(`${parsed.duplicates} trùng`);
        if (parsed.ignored.length) bits.push(`${parsed.ignored.length} bỏ qua`);
        if (parsed.codes.length) bits.push(`~${Math.ceil(etaSec)}s`);
        $('df-parse-hint').textContent = bits.join(' · ');
        const box = $('df-suspicious');
        if (parsed.suspicious.length) {
            box.style.display = 'block';
            box.innerHTML = parsed.suspicious.slice(0, 8).map((s) =>
                `⚠ <b>${escapeHtml(s.token)}</b> → <b>${escapeHtml(s.suggestion)}</b>`
            ).join('<br>') +
                (parsed.suspicious.length > 8 ? `<br>… +${parsed.suspicious.length - 8}` : '') +
                `<br><button class="mini-btn" id="df-fix-all" style="margin-top:6px">Áp dụng tất cả gợi ý</button>`;
            const fix = $('df-fix-all');
            if (fix) fix.onclick = applySuspiciousFixes;
        } else {
            box.style.display = 'none';
            box.innerHTML = '';
        }
        $('df-eta').textContent = parsed.codes.length
            ? `Ước tính ~${formatDuration(etaSec * 1000)} với delay ${defaultDelay.toFixed(1)}s`
            : '';
    }

    function applySuspiciousFixes() {
        let text = $('df-code-input').value;
        for (const s of lastSuspicious) {
            text = text.split(s.token).join(s.suggestion);
        }
        $('df-code-input').value = text;
        previewParse();
        addLog(`Đã sửa ${lastSuspicious.length} code ký tự giả.`, 'info');
    }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, (c) => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[c]));
    }

    function formatDuration(ms) {
        const s = Math.max(0, Math.round(ms / 1000));
        if (s < 60) return `${s}s`;
        const m = Math.floor(s / 60);
        const r = s % 60;
        return `${m}p${r ? r + 's' : ''}`;
    }

    $('df-code-input').addEventListener('input', previewParse);

    function parseMessage(text) {
        const raw = String(text || '').trim();
        const hint = /error_hint_(\d+)/i.exec(raw);
        if (hint && RESULT_BY_CODE[hint[1]]) {
            const known = RESULT_BY_CODE[Number(hint[1])];
            return { status: known.kind, msg: known.text, code: Number(hint[1]) };
        }
        const num = /\b(4000\d{2}|503\d{3}|300001|0)\b/.exec(raw);
        if (num && RESULT_BY_CODE[num[1]]) {
            const known = RESULT_BY_CODE[Number(num[1])];
            return { status: known.kind, msg: known.text, code: Number(num[1]) };
        }
        const lower = raw.toLowerCase();
        if (/thành công|chúc mừng|success|congratulations/i.test(lower)) {
            return { status: 'success', msg: RESULT_BY_CODE[0].text };
        }
        if (/đã sử dụng|đã nhận|đã đổi|already|limit|reached|giới hạn/i.test(lower)) {
            return { status: 'used', msg: raw };
        }
        if (/không hợp lệ|invalid|hết hạn|expired|hết lượt/i.test(lower)) {
            return { status: 'invalid', msg: raw };
        }
        if (/đăng nhập|login|hết hạn phiên|token/i.test(lower)) {
            return { status: 'session', msg: 'Mất phiên đăng nhập! Hãy tải lại trang.' };
        }
        if (/mạng|network|timeout|kết nối/i.test(lower)) {
            return { status: 'network', msg: raw };
        }
        return { status: 'error', msg: raw || 'Không đọc được phản hồi' };
    }

    const inspectResponse = async (timeoutMs) => {
        const timeout = Math.max(2500, timeoutMs || 8000);
        const checkInterval = 120;
        const startTime = Date.now();
        while (Date.now() - startTime < timeout) {
            const popups = Array.from(document.querySelectorAll(
                '.van-dialog, .van-toast, .modal, .dialog, .popup, div[role="dialog"], [class*="notice"], [class*="alert"], #diaTips, #superTips'
            )).filter((el) => !panel.contains(el) && el.getBoundingClientRect().width > 0 && window.getComputedStyle(el).display !== 'none');

            for (const pop of popups) {
                const text = (pop.innerText || pop.textContent || '').trim();
                if (text.length > 2) {
                    const closeBtn = Array.from(pop.querySelectorAll('button, div[role="button"], span'))
                        .find((b) => /ok|xác nhận|confirm|đóng|close|biết rồi/i.test((b.innerText || '').toLowerCase()));
                    if (closeBtn) closeBtn.click();
                    const cleanMsg = text.split('\n').filter((t) => t.trim().length > 0)[0];
                    return parseMessage(cleanMsg);
                }
            }
            await sleep(checkInterval);
        }
        return { status: 'network', msg: 'Hết thời gian chờ / lỗi mạng' };
    };

    function updateCounterView(total, success, used, failed) {
        $('cnt-total').textContent = String(total);
        $('cnt-success').textContent = String(success);
        $('cnt-used').textContent = String(used);
        $('cnt-failed').textContent = String(failed);
    }

    const startBtn = $('df-start-btn');
    const pauseBtn = $('df-pause-btn');
    const stopBtn = $('df-stop-btn');

    pauseBtn.addEventListener('click', () => {
        isPaused = !isPaused;
        if (isPaused) {
            pauseBtn.innerText = 'Tiếp tục';
            addLog('⏸️ Đã tạm dừng tiến trình', 'used');
        } else {
            pauseBtn.innerText = 'Tạm dừng';
            addLog('▶️ Tiếp tục chạy', 'info');
        }
    });

    stopBtn.addEventListener('click', () => {
        if (isRunning) {
            isRunning = false;
            addLog('⏹️ Yêu cầu dừng! Đang ngắt hệ thống...', 'error');
        }
    });

    function csvEscape(v) {
        const s = String(v ?? '');
        if (/[",\n]/.test(s)) return `"${s.replace(/"/g, '""')}"`;
        return s;
    }

    function downloadCsv(filename, rows) {
        const header = ['code', 'status', 'message', 'delaySec'];
        const body = rows.map((r) => [r.code, r.status, r.msg || r.message || '', r.delaySec ?? ''].map(csvEscape).join(','));
        const blob = new Blob(['\uFEFF' + header.join(',') + '\n' + body.join('\n')], { type: 'text/csv;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = filename;
        a.click();
        URL.revokeObjectURL(a.href);
    }

    function pushHistory(job) {
        const state = loadState();
        const history = Array.isArray(state.history) ? state.history : [];
        history.unshift(job);
        saveState({ history: history.slice(0, MAX_HISTORY) });
    }

    function renderHistory() {
        const history = loadState().history || [];
        const box = $('df-history-list');
        if (!history.length) {
            box.innerHTML = '<div class="hist-item">Chưa có job nào.</div>';
            return;
        }
        box.innerHTML = history.map((h, idx) => {
            const t = new Date(h.at).toLocaleString('vi-VN');
            return `<div class="hist-item">
                <b>${t}</b>
                Tổng ${h.total} · OK ${h.success} · Đã nhận ${h.used} · Lỗi ${h.failed}
                <div class="btn-row" style="margin:6px 0 0">
                    <button class="mini-btn" data-load="${idx}">Nạp code lỗi</button>
                    <button class="mini-btn" data-csv="${idx}">CSV</button>
                </div>
            </div>`;
        }).join('');
        box.querySelectorAll('[data-load]').forEach((btn) => {
            btn.onclick = () => {
                const job = history[Number(btn.dataset.load)];
                const failed = (job.results || []).filter((r) => !['success', 'used'].includes(r.status));
                $('df-code-input').value = failed.map((r) => r.code).join('\n');
                panel.querySelector('[data-tab="run"]').click();
                previewParse();
                addLog(`Đã nạp ${failed.length} code lỗi từ lịch sử.`, 'info');
            };
        });
        box.querySelectorAll('[data-csv]').forEach((btn) => {
            btn.onclick = () => {
                const job = history[Number(btn.dataset.csv)];
                downloadCsv(`df-redeem-${job.at}.csv`, job.results || []);
            };
        });
    }

    $('df-import-btn').addEventListener('click', () => $('df-file').click());
    $('df-file').addEventListener('change', async (e) => {
        const file = e.target.files && e.target.files[0];
        e.target.value = '';
        if (!file) return;
        const text = await file.text();
        const cur = $('df-code-input').value.trim();
        $('df-code-input').value = cur ? cur + '\n' + text : text;
        previewParse();
        addLog(`Đã import ${file.name}`, 'info');
    });

    $('df-export-btn').addEventListener('click', () => {
        if (!lastResults.length) {
            addLog('Chưa có kết quả để xuất.', 'error');
            return;
        }
        downloadCsv(`df-redeem-${Date.now()}.csv`, lastResults);
        addLog('Đã tải file CSV.', 'success');
    });

    $('df-retry-btn').addEventListener('click', () => {
        const failed = lastResults.filter((r) => !['success', 'used'].includes(r.status));
        if (!failed.length) {
            addLog('Không có code lỗi để thử lại.', 'used');
            return;
        }
        $('df-code-input').value = failed.map((r) => r.code).join('\n');
        previewParse();
        addLog(`Đã nạp lại ${failed.length} code lỗi.`, 'info');
    });

    $('df-clear-btn').addEventListener('click', () => {
        $('df-code-input').value = '';
        previewParse();
    });

    $('df-hist-export').addEventListener('click', () => {
        const history = loadState().history || [];
        if (!history.length || !history[0].results) {
            addLog('Chưa có job để xuất.', 'error');
            return;
        }
        downloadCsv(`df-redeem-${history[0].at}.csv`, history[0].results);
    });

    $('df-hist-clear').addEventListener('click', () => {
        saveState({ history: [] });
        renderHistory();
    });

    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && panel.style.display === 'block' && !isRunning) {
            e.preventDefault();
            runBatch();
        }
    });

    async function runBatch() {
        checkLoginStatus();
        if (!authData.isLoggedIn) {
            addLog('❌ Vui lòng đăng nhập và chọn nhân vật trên web trước!', 'error');
            return;
        }

        const parsed = parseCodes($('df-code-input').value);
        if (parsed.suspicious.length) {
            addLog(`⚠ Có ${parsed.suspicious.length} code ký tự giả. Bấm "Áp dụng tất cả gợi ý" hoặc sửa tay trước khi chạy.`, 'used');
            return;
        }
        const list = parsed.codes;
        if (!list.length) {
            addLog('⚠️ Không có code hợp lệ (tối thiểu 6 ký tự, có chữ).', 'error');
            return;
        }
        if (parsed.duplicates) addLog(`Đã loại ${parsed.duplicates} code trùng.`, 'info');
        if (parsed.ignored.length) addLog(`Đã bỏ qua ${parsed.ignored.length} chuỗi không phải code.`, 'info');

        const defaultDelay = Number($('df-delay-range').value) || DELAY.default;
        let successCount = 0, usedCount = 0, failCount = 0;
        updateCounterView(list.length, 0, 0, 0);
        lastResults = [];

        isRunning = true;
        isPaused = false;
        startBtn.style.display = 'none';
        pauseBtn.style.display = 'block';
        pauseBtn.innerText = 'Tạm dừng';
        stopBtn.style.display = 'block';
        $('df-delay-range').disabled = true;

        addLog(`🚀 Bắt đầu ${list.length} mã · delay mặc định ${defaultDelay.toFixed(1)}s`, 'info');

        let networkStreak = 0;
        let unknownStreak = 0;

        for (let i = 0; i < list.length; i++) {
            if (!isRunning) {
                addLog(`⏹️ Đã hủy tại mã thứ ${i}/${list.length}`, 'error');
                break;
            }
            while (isPaused && isRunning) await sleep(250);
            if (!isRunning) break;

            const item = list[i];
            const code = item.code;
            const waitSec = item.delaySec != null ? item.delaySec : defaultDelay;
            addLog(`[${i + 1}/${list.length}] Gửi: ${code}`, 'info');

            let outcome = null;
            for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
                const currentInput = getCDKInput();
                if (!currentInput) {
                    outcome = { status: 'session', msg: 'Không tìm thấy ô nhập mã.' };
                    break;
                }
                setInputValue(currentInput, code);
                await sleep(Math.max(80, Math.round(waitSec * 80)));

                const submitBtn = getSubmitButton();
                if (!submitBtn) {
                    outcome = { status: 'error', msg: 'Không tìm thấy nút Đổi.' };
                    break;
                }
                submitBtn.click();
                outcome = await inspectResponse(Math.max(4000, waitSec * 1500));

                if (outcome.status === 'network' && attempt < MAX_ATTEMPTS && isRunning) {
                    addLog(`↻ ${code}: lỗi mạng, thử lại ${attempt + 1}/${MAX_ATTEMPTS}`, 'network');
                    await sleep(waitSec * 2000);
                    continue;
                }
                break;
            }

            const row = { code, status: outcome.status, msg: outcome.msg, delaySec: item.delaySec ?? defaultDelay };
            lastResults.push(row);

            if (outcome.status === 'success') {
                successCount++;
                networkStreak = 0;
                unknownStreak = 0;
                addLog(`✔ ${code}: ${outcome.msg}`, 'success');
            } else if (outcome.status === 'used') {
                usedCount++;
                networkStreak = 0;
                unknownStreak = 0;
                addLog(`⚡ ${code}: ${outcome.msg}`, 'used');
            } else if (outcome.status === 'invalid') {
                failCount++;
                networkStreak = 0;
                unknownStreak = 0;
                addLog(`✖ ${code}: ${outcome.msg}`, 'invalid');
            } else if (outcome.status === 'session') {
                failCount++;
                addLog(`🛑 ${outcome.msg} Dừng an toàn.`, 'session');
                isRunning = false;
                break;
            } else if (outcome.status === 'network') {
                failCount++;
                networkStreak++;
                addLog(`✖ ${code}: ${outcome.msg}`, 'network');
                if (networkStreak >= MAX_NETWORK_STREAK) {
                    addLog(`⏸️ ${MAX_NETWORK_STREAK} lỗi mạng liên tiếp — tạm dừng.`, 'error');
                    isPaused = true;
                    pauseBtn.innerText = 'Tiếp tục';
                    networkStreak = 0;
                }
            } else {
                failCount++;
                unknownStreak++;
                addLog(`✖ ${code}: ${outcome.msg}`, 'error');
                if (unknownStreak >= MAX_UNKNOWN_STREAK) {
                    addLog(`⏸️ ${MAX_UNKNOWN_STREAK} kết quả lạ liên tiếp — tạm dừng (có thể bị giới hạn).`, 'error');
                    isPaused = true;
                    pauseBtn.innerText = 'Tiếp tục';
                    unknownStreak = 0;
                }
            }

            updateCounterView(list.length, successCount, usedCount, failCount);
            const remain = list.length - i - 1;
            $('df-eta').textContent = remain > 0
                ? `Còn ${remain} mã · ~${formatDuration(remain * ((item.delaySec ?? defaultDelay) * 1000 + 1200))}`
                : 'Hoàn tất danh sách.';

            if (i < list.length - 1 && isRunning) await sleep(Math.round(waitSec * 1000));
        }

        pushHistory({
            at: Date.now(),
            total: list.length,
            success: successCount,
            used: usedCount,
            failed: failCount,
            results: lastResults,
        });

        if (isRunning) addLog(`🏁 Xong! Thành công ${successCount} · Đã nhận ${usedCount} · Lỗi ${failCount}`, 'success');

        isRunning = false;
        startBtn.style.display = 'block';
        startBtn.innerText = 'Chạy lại';
        pauseBtn.style.display = 'none';
        stopBtn.style.display = 'none';
        $('df-delay-range').disabled = false;
        renderHistory();
    }

    startBtn.addEventListener('click', runBatch);
    previewParse();
})();
