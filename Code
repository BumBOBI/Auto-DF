// ==UserScript==
// @name         Delta Force Garena Auto Redeem v1.3
// @namespace    https://staybrowser.com/
// @version      1.3
// @description  Tự động nhập code Delta Force Garena v1.3. Tích hợp kiểm tra đăng nhập, chọn tốc độ, phân loại kết quả và loại bỏ code trùng.
// @author       BumBOBI
// @match        *://redeem.df.garena.sg/*
// @grant        GM_addStyle
// @run-at       document-idle
// ==/UserScript==

(function() {
    'use strict';

    let isRunning = false;
    let isPaused = false;
    let authData = { isLoggedIn: false };

    const css = `
        #df-redeem-btn {
            position: fixed;
            bottom: 25px;
            right: 15px;
            z-index: 999999;
            background: linear-gradient(135deg, #ff5722, #d84315);
            color: #fff;
            padding: 12px 16px;
            border-radius: 50px;
            font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 14px;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(255,87,34,0.4);
            border: 1px solid rgba(255,255,255,0.2);
            cursor: pointer;
        }
        #df-redeem-panel {
            position: fixed;
            bottom: 80px;
            right: 15px;
            width: 330px;
            max-width: 92vw;
            background: #111319;
            border: 1px solid #262a38;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            padding: 14px;
            z-index: 999999;
            display: none;
            font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            color: #e6e8ee;
        }
        .df-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }
        .df-title { font-weight: 800; font-size: 14px; color: #fff; }
        .df-badge { background: rgba(0,230,118,0.15); color: #00e676; padding: 2px 6px; border-radius: 4px; font-size: 10px; }
        
        .df-auth-banner {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 8px;
            background: #1c1316;
            border: 1px solid rgba(255, 82, 82, 0.3);
            color: #ff5252;
            transition: all 0.3s;
        }
        .df-auth-banner.logged {
            background: #102619;
            border-color: rgba(0, 230, 118, 0.3);
            color: #00e676;
        }

        #df-counter-box {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin-bottom: 8px;
            text-align: center;
        }
        .counter-badge {
            background: #181b24;
            padding: 6px 2px;
            border-radius: 6px;
            border: 1px solid #262a38;
        }
        .counter-val { font-size: 14px; font-weight: bold; }
        .counter-title { font-size: 9px; color: #8b92a5; text-transform: uppercase; margin-top:2px; }
        
        .speed-control {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 12px;
            background: #181b24;
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #262a38;
            color: #8b92a5;
        }
        .speed-control select {
            background: #0f1118;
            color: #ffab00;
            border: 1px solid #363b50;
            border-radius: 4px;
            padding: 4px 8px;
            font-weight: bold;
            font-size: 12px;
            outline: none;
        }
        #df-code-input {
            width: 100%;
            height: 70px;
            box-sizing: border-box;
            background: #0d0e14;
            color: #fff;
            border: 1px solid #262a38;
            border-radius: 6px;
            padding: 8px;
            font-size: 12px;
            resize: none;
            margin-bottom: 8px;
            font-family: monospace;
        }
        .btn-group { display: flex; gap: 6px; }
        .action-btn, .pause-btn, .stop-btn {
            border: none; padding: 10px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 12px;
        }
        .action-btn { flex: 2; background: #ff5722; color: #fff; }
        .pause-btn { flex: 1; background: #373b4d; color: #ffab00; display: none; }
        .stop-btn { flex: 1; background: #3e1b21; color: #ff5252; border: 1px solid rgba(255,82,82,0.3); display: none; }
        
        #df-redeem-logs {
            font-size: 11px;
            margin-top: 8px;
            height: 90px;
            overflow-y: auto;
            border: 1px solid #262a38;
            border-radius: 6px;
            padding: 6px;
            background: #0b0c10;
            font-family: monospace;
        }
        .log-item { margin-bottom: 4px; line-height: 1.3; }
        .log-time { color: #525970; margin-right: 4px;}
        .log-success { color: #00e676; }
        .log-used { color: #ffab00; }
        .log-error { color: #ff5252; }
        .log-info { color: #40c4ff; }
    `;

    if (typeof GM_addStyle !== "undefined") {
        GM_addStyle(css);
    } else {
        const style = document.createElement('style');
        style.textContent = css;
        document.head.appendChild(style);
    }

    const triggerBtn = document.createElement('button');
    triggerBtn.id = 'df-redeem-btn';
    triggerBtn.innerHTML = '⚡ DF TOOL 1.3';

    const panel = document.createElement('div');
    panel.id = 'df-redeem-panel';
    panel.innerHTML = `
        <div class="df-header">
            <div class="df-title">🎮 Delta Force Redeem</div>
            <div class="df-badge">v1.3</div>
        </div>
        <div id="df-auth-status" class="df-auth-banner">🔴 Đang kiểm tra đăng nhập...</div>
        <div id="df-counter-box">
            <div class="counter-badge">
                <div class="counter-val" id="cnt-total" style="color: #40c4ff;">0</div>
                <div class="counter-title">Tổng mã</div>
            </div>
            <div class="counter-badge">
                <div class="counter-val" id="cnt-success" style="color: #00e676;">0</div>
                <div class="counter-title">Thành công</div>
            </div>
            <div class="counter-badge">
                <div class="counter-val" id="cnt-used" style="color: #ffab00;">0</div>
                <div class="counter-title">Đã nhận</div>
            </div>
            <div class="counter-badge">
                <div class="counter-val" id="cnt-failed" style="color: #ff5252;">0</div>
                <div class="counter-title">Thất bại</div>
            </div>
        </div>
        <div class="speed-control">
            <span>Tốc độ chạy:</span>
            <select id="df-speed-select">
                <option value="0.75">x0.75 (Chậm)</option>
                <option value="1" selected>x1.0 (Chuẩn)</option>
                <option value="1.5">x1.5 (Vừa)</option>
                <option value="2">x2.0 (Nhanh)</option>
                <option value="3">x3.0 (Siêu tốc)</option>
                <option value="4">x4.0 (Cực hạn)</option>
            </select>
        </div>
        <textarea id="df-code-input" placeholder="Dán danh sách mã code vào đây (xuống dòng hoặc dấu cách)..."></textarea>
        <div class="btn-group">
            <button class="action-btn" id="df-start-btn">Bắt đầu chạy</button>
            <button class="pause-btn" id="df-pause-btn">Tạm dừng</button>
            <button class="stop-btn" id="df-stop-btn">Dừng hẳn</button>
        </div>
        <div id="df-redeem-logs">
            <div class="log-item"><span class="log-info">Sẵn sàng hoạt động!</span></div>
        </div>
    `;

    document.body.appendChild(triggerBtn);
    document.body.appendChild(panel);

    triggerBtn.addEventListener('click', () => {
        panel.style.display = (panel.style.display === 'none' || panel.style.display === '') ? 'block' : 'none';
        checkLoginStatus(); 
    });

    const addLog = (text, type = 'info') => {
        const logBox = document.getElementById('df-redeem-logs');
        if (!logBox) return;
        const div = document.createElement('div');
        div.className = `log-item log-${type}`;
        const now = new Date();
        const timeStr = `${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
        div.innerHTML = `<span class="log-time">[${timeStr}]</span>${text}`;
        logBox.appendChild(div);
        logBox.scrollTop = logBox.scrollHeight;
    };

    const sleep = (ms) => new Promise(r => setTimeout(r, ms));

    const setInputValue = (input, val) => {
        input.focus();
        const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value")?.set;
        if (nativeSetter) nativeSetter.call(input, val);
        else input.value = val;
        
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        input.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
    };

    function getCDKInput() {
        const inputs = Array.from(document.querySelectorAll('input[type="text"], input:not([type])'))
            .filter(el => !panel.contains(el) && el.offsetParent !== null);

        let cdkInput = inputs.find(el => {
            const attr = (el.placeholder + ' ' + el.id + ' ' + el.name + ' ' + el.className).toLowerCase();
            return attr.includes('cdk') || attr.includes('code') || attr.includes('mã') || attr.includes('quà');
        });

        return cdkInput || (inputs.length > 0 ? inputs[inputs.length - 1] : null);
    }

    function getSubmitButton() {
        const buttons = Array.from(document.querySelectorAll('button, div[role="button"], a, [class*="btn"]'))
            .filter(b => !panel.contains(b) && b.offsetParent !== null);

        return buttons.find(b => {
            const txt = (b.innerText || b.textContent || '').trim().toLowerCase();
            return ['đổi', 'xác nhận', 'nhận', 'redeem', 'exchange', 'confirm'].some(kw => txt.includes(kw));
        });
    }

    function checkLoginStatus() {
        const authBanner = document.getElementById('df-auth-status');
        const inputField = getCDKInput();
        
        if (inputField) {
            authData.isLoggedIn = true;
            authBanner.className = 'df-auth-banner logged';
            authBanner.innerText = '🟢 Đã đăng nhập & Chọn nhân vật thành công';
        } else {
            authData.isLoggedIn = false;
            authBanner.className = 'df-auth-banner';
            authBanner.innerText = '🔴 Chưa thấy ô nhập code. Hãy đăng nhập!';
        }
        return authData.isLoggedIn;
    }
    
    setInterval(checkLoginStatus, 2000);

    function parseMessage(text) {
        const lower = text.toLowerCase();
        
        if (/thành công|chúc mừng|success|congratulations/i.test(lower)) {
            return { status: 'success', msg: text };
        }
        if (/đã sử dụng|đã nhận|đã đổi|already|limit|reached|giới hạn|400067|400065|400066/i.test(lower)) {
            return { status: 'used', msg: text };
        }
        if (/đăng nhập|login|hết hạn|token|400006/i.test(lower)) {
            return { status: 'expired', msg: 'Mất phiên đăng nhập! Hãy tải lại trang.' };
        }
        return { status: 'error', msg: text };
    }

    const inspectResponse = async (speedMultiplier) => {
        const timeout = Math.max(900, Math.round(4500 / speedMultiplier));
        const checkInterval = Math.max(50, Math.round(250 / speedMultiplier));
        const startTime = Date.now();

        while (Date.now() - startTime < timeout) {
            const popups = Array.from(document.querySelectorAll('.van-dialog, .van-toast, .modal, .dialog, .popup, div[role="dialog"], [class*="notice"], [class*="alert"]'))
                .filter(el => !panel.contains(el) && el.getBoundingClientRect().width > 0 && window.getComputedStyle(el).display !== 'none');

            for (const pop of popups) {
                const text = (pop.innerText || pop.textContent || "").trim();
                if (text.length > 2) {
                    const closeBtn = Array.from(pop.querySelectorAll('button, div[role="button"], span'))
                        .find(b => /ok|xác nhận|confirm|đóng|close|biết rồi/i.test((b.innerText || '').toLowerCase()));
                    if (closeBtn) closeBtn.click();

                    const cleanMsg = text.split('\n').filter(t => t.trim().length > 0)[0];
                    return parseMessage(cleanMsg);
                }
            }
            await sleep(checkInterval);
        }
        return { status: 'error', msg: 'Hết thời gian chờ / Lỗi mạng' };
    };

    function updateCounterView(total, success, used, failed) {
        const elTotal = document.getElementById('cnt-total');
        const elSuccess = document.getElementById('cnt-success');
        const elUsed = document.getElementById('cnt-used');
        const elFailed = document.getElementById('cnt-failed');

        elTotal.textContent = String(total);
        elSuccess.textContent = String(success);
        elUsed.textContent = String(used);
        elFailed.textContent = String(failed);

        void elSuccess.offsetHeight; 
        void elFailed.offsetHeight;
    }

    const startBtn = document.getElementById('df-start-btn');
    const pauseBtn = document.getElementById('df-pause-btn');
    const stopBtn = document.getElementById('df-stop-btn');
    const speedSelect = document.getElementById('df-speed-select');

    pauseBtn.addEventListener('click', () => {
        isPaused = !isPaused;
        if (isPaused) {
            pauseBtn.innerText = 'Tiếp tục';
            addLog('⏸️ Đã tạm dừng tiến trình', 'used');
        } else {
            pauseBtn.innerText = 'Tạm dừng';
            addLog('▶️ Tiếp tục chạy', 'info');
        }
    });

    stopBtn.addEventListener('click', () => {
        if (isRunning) {
            isRunning = false;
            addLog('⏹️ Yêu cầu dừng! Đang ngắt hệ thống...', 'error');
        }
    });

    async function runBatch() {
        checkLoginStatus();
        if (!authData.isLoggedIn) {
            addLog('❌ Vui lòng đăng nhập và chọn nhân vật trên web trước!', 'error');
            return;
        }

        const textarea = document.getElementById('df-code-input');
        
        const rawTokens = textarea.value.split(/[\s,]+/).map(c => c.trim()).filter(c => c.length >= 4);
        const list = [...new Set(rawTokens)]; 

        if (list.length === 0) {
            addLog('⚠️ Vui lòng dán code hợp lệ vào ô!', 'error');
            return;
        }

        const speed = parseFloat(speedSelect.value) || 1;
        const inputDelay = Math.max(70, Math.round(650 / speed));
        const pauseDelay = Math.max(200, Math.round(1800 / speed));

        let successCount = 0, usedCount = 0, failCount = 0;
        updateCounterView(list.length, 0, 0, 0);

        isRunning = true;
        isPaused = false;
        startBtn.style.display = 'none';
        pauseBtn.style.display = 'block';
        pauseBtn.innerText = 'Tạm dừng';
        stopBtn.style.display = 'block';
        speedSelect.disabled = true;

        addLog(`🚀 Bắt đầu chạy ${list.length} mã (Tốc độ x${speed})...`, 'info');

        for (let i = 0; i < list.length; i++) {
            if (!isRunning) {
                addLog(`⏹️ Đã hủy tại mã thứ ${i}/${list.length}`, 'error');
                break;
            }

            while (isPaused && isRunning) {
                await sleep(500); 
            }
            if (!isRunning) break;

            const code = list[i];
            addLog(`[${i + 1}/${list.length}] Đang gửi: ${code}...`, 'info');

            const currentInput = getCDKInput();
            if (currentInput) {
                setInputValue(currentInput, code);
            } else {
                addLog('❌ Không tìm thấy ô nhập mã! Mất kết nối.', 'error');
                break;
            }

            await sleep(inputDelay);

            const submitBtn = getSubmitButton();
            if (submitBtn) {
                submitBtn.click();
                const res = await inspectResponse(speed);
                
                if (res.status === 'success') {
                    successCount++;
                    addLog(`✔ ${code}: ${res.msg}`, 'success');
                } else if (res.status === 'used') {
                    usedCount++;
                    addLog(`⚡ ${code}: ${res.msg}`, 'used');
                } else if (res.status === 'expired') {
                    addLog(`🛑 Bị văng đăng nhập! Dừng tool an toàn.`, 'error');
                    isRunning = false;
                    break;
                } else {
                    failCount++;
                    addLog(`✖ ${code}: ${res.msg}`, 'error');
                }
            } else {
                failCount++;
                addLog(`✖ ${code}: Không tìm thấy nút Đổi!`, 'error');
            }

            updateCounterView(list.length, successCount, usedCount, failCount);
            await sleep(pauseDelay);
        }

        if (isRunning) {
            addLog(`🏁 Kết thúc! Thành công: ${successCount} | Đã dùng: ${usedCount} | Lỗi: ${failCount}`, 'success');
        }

        isRunning = false;
        startBtn.style.display = 'block';
        startBtn.innerText = 'Chạy Lại';
        pauseBtn.style.display = 'none';
        stopBtn.style.display = 'none';
        speedSelect.disabled = false;
    }

    startBtn.addEventListener('click', runBatch);
})();
