// ==UserScript==
// @name         Delta Force Garena Auto Redeem (Engine Rebuild v3.1)
// @namespace    https://staybrowser.com/
// @version      1.1
// @description  Hệ thống tự động redeem code Delta Force kiến trúc v3.1: State Engine, Queue deduplication, MutationObserver, Bộ lọc kết quả chi tiết
// @author       Vibe Coding x Lhyuz
// @match        *://redeem.df.garena.sg/*
// @grant        GM_addStyle
// @run-at       document-idle
// ==/UserScript==

(function() {
    'use strict';

    /* ==========================================================================
       1. STATE ENGINE & EVENT BUS
       ========================================================================== */
    const State = {
        status: 'IDLE', // IDLE, RUNNING, PAUSED, STOPPED
        queue: [],
        currentIndex: 0,
        stats: {
            total: 0,
            success: 0,
            used: 0,
            invalid: 0,
            failed: 0
        },
        speedMultiplier: 1.0,
        failedCodes: []
    };

    const EventBus = {
        listeners: {},
        on(event, callback) {
            if (!this.listeners[event]) this.listeners[event] = [];
            this.listeners[event].push(callback);
        },
        emit(event, data) {
            if (this.listeners[event]) {
                this.listeners[event].forEach(cb => cb(data));
            }
        }
    };

    /* ==========================================================================
       2. UI STYLES (Modern Cyberpunk / Dark Dashboard)
       ========================================================================== */
    const styles = `
        :root {
            --df-primary: #ff5722;
            --df-primary-hover: #f4511e;
            --df-bg: #111319;
            --df-card: #181b24;
            --df-border: #262a38;
            --df-text: #e6e8ee;
            --df-muted: #8b92a5;
            --df-success: #00e676;
            --df-warn: #ffab00;
            --df-danger: #ff5252;
            --df-info: #40c4ff;
        }

        #df-floating-trigger {
