// ==UserScript==
// @name         Delta Force Garena Auto Redeem
// @namespace    https://staybrowser.com/
// @version      1.4
// @description  Hệ thống tự động redeem code Delta Force Garena v1.4 - Đã loại bỏ cơ chế khóa phiên bản
// @author       BumBOBI
// @match        *://redeem.df.garena.sg/*
// @grant        GM_addStyle
// @run-at       document-start
// ==/UserScript==

(function() {
    'use strict';

    let lastApiResponse = null;
    let authData = {
        isLoggedIn: false,
        roleName: '',
        roleId: '',
        openid: ''
    };

    // Theo dõi fetch để lấy thông tin đăng nhập và kết quả redeem
    const globalContext = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const originalFetch = globalContext.fetch;

    if (originalFetch) {
        globalContext.fetch = async function(...args) {
            const url = typeof args[0] === 'string' ? args[0] : (args[0]?.url || '');
            const response = await originalFetch.apply(this, args);

            try {
                if (url.includes('openid=') || url.includes('token=')) {
                    authData.isLoggedIn = true;
                    const urlObj = new URL(url, window.location.href);
                    const oid = urlObj.searchParams.get('openid');
                    if (oid) authData.openid = oid;
                    updateAuthUI();
                }

                if (url.includes('GetRole') || url.includes('role_info') || url.includes('user/info') || url.includes('RoleList')) {
                    const cloned = response.clone();
                    cloned.json().then(data => {
                        if (data && data.data) {
                            authData.isLoggedIn = true;
                            const role = data.data.role_name || data.data.role_id || data.data.nick_name || (Array.isArray(data.data.roles) && data.data.roles[0]?.role_name);
                            if (role) authData.roleName = String(role);
                            updateAuthUI();
                        }
                    }).catch(() => {});
                }

                if (url.includes('RedeemCDKey') || url.includes('CdkV2')) {
                    const cloned = response.clone();
                    cloned.json().then(data => {
                        lastApiResponse = data;
                        window.dispatchEvent(new CustomEvent('df_redeem_event', { detail: data }));
                    }).catch(() => {});
                }
            } catch (e) {}

            return response;
        };
    }

    const State = {
        status: 'IDLE',
        queue: [],
        currentIndex: 0,
        stats: {
            total: 0,
            success: 0,
            used: 0,
            invalid: 0,
            failed: 0
        },
        speedMultiplier: 2.0,
        failedCodes: []
    };

    const styles = `
        :root {
            --df-primary: #ff5722;
            --df-primary-hover: #f4511e;
            --df-bg: #111319;
            --df-card: #181b24;
            --df-border: #262a38;
            --df-text: #e6e8ee;
            --df-muted: #8b92a5;
            --df-success: #00e676;
            --df-warn: #ffab00;
            --df-danger: #ff5252;
            --df-info: #40c4ff;
        }

        #df-floating-trigger {
            position: fixed;
            bottom: 25px;
            right: 20px;
            z-index: 999999;
            background: linear-gradient(135deg, var(--df-primary), #d84315);
            color: #fff;
            padding: 12px 18px;
            border-radius: 50px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.5px;
            box-shadow: 0 6px 20px rgba(255, 87, 34, 0.45);
            border: 1px solid rgba(255,255,255,0.2);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            user-select: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        #df-floating-trigger:active {
            transform: scale(0.95);
        }

        #df-dashboard-v3 {
            position: fixed;
            bottom: 85px;
            right: 15px;
            width: 350px;
            max-width: 92vw;
            background: var(--df-bg);
            border: 1px solid var(--df-border);
            border-radius: 14px;
            box-shadow: 0 16px 45px rgba(0, 0, 0, 0.8);
            z-index: 999999;
            display: none;
            flex-direction: column;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: var(--df-text);
        }

        .df-header {
            background: var(--df-card);
            padding: 12px 16px;
            border-bottom: 1px solid var(--df-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .df-title {
            font-weight: 800;
            font-size: 13px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .df-badge-ver {
            background: rgba(0, 230, 118, 0.15);
            color: var(--df-success);
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: bold;
        }

        .df-body {
            position: relative;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .df-auth-banner {
            padding: 7px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #1c1316;
            border: 1px solid rgba(255, 82, 82, 0.3);
            color: var(--df-danger);
        }
        .df-auth-banner.df-logged {
            background: #102619;
            border-color: rgba(0, 230, 118, 0.3);
            color: var(--df-success);
        }

        .df-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
        }
        .df-stat-card {
            background: var(--df-card);
            border: 1px solid var(--df-border);
            border-radius: 8px;
            padding: 8px 4px;
            text-align: center;
        }
        .df-stat-val {
            font-size: 15px;
            font-weight: 800;
            line-height: 1.2;
        }
        .df-stat-lbl {
            font-size: 9px;
            text-transform: uppercase;
            color: var(--df-muted);
            margin-top: 2px;
        }

        .df-progress-wrap {
            height: 6px;
            background: #1e2230;
            border-radius: 3px;
            overflow: hidden;
            position: relative;
        }
        .df-progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--df-primary), var(--df-success));
            transition: width 0.25s ease;
        }

        .df-setting-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: var(--df-muted);
            background: var(--df-card);
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid var(--df-border);
        }
        .df-select {
            background: #0f1118;
            color: var(--df-warn);
            border: 1px solid #363b50;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: 12px;
            font-weight: bold;
            outline: none;
        }

        #df-code-input {
            width: 100%;
            height: 75px;
            background: #0d0e14;
            border: 1px solid var(--df-border);
            border-radius: 8px;
            padding: 8px;
            font-size: 12px;
            color: #fff;
            box-sizing: border-box;
            resize: none;
            font-family: monospace;
        }
        #df-code-input:focus {
            border-color: var(--df-primary);
            outline: none;
        }

        .df-actions {
            display: flex;
            gap: 6px;
        }
        .df-btn {
            border: none;
            border-radius: 6px;
            padding: 10px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .df-btn:active { opacity: 0.8; }
        .df-btn-primary {
            flex: 2;
            background: var(--df-primary);
            color: white;
        }
        .df-btn-warn {
            flex: 1;
            background: #373b4d;
            color: var(--df-warn);
            display: none;
        }
        .df-btn-danger {
            flex: 1;
            background: #3e1b21;
            color: var(--df-danger);
            border: 1px solid rgba(255,82,82,0.3);
            display: none;
        }

        #df-logs-panel {
            background: #0b0c10;
            border: 1px solid var(--df-border);
            border-radius: 8px;
            height: 100px;
            overflow-y: auto;
            padding: 8px;
            font-size: 11px;
            font-family: monospace;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .df-log-entry {
            display: flex;
            gap: 6px;
            line-height: 1.3;
        }
        .df-log-time { color: #525970; }
        .df-log-txt { word-break: break-all; }
        .df-log-success { color: var(--df-success); }
        .df-log-warn { color: var(--df-warn); }
        .df-log-danger { color: var(--df-danger); }
        .df-log-info { color: var(--df-info); }
    `;

    function initUI() {
        if (typeof GM_addStyle !== "undefined") {
            GM_addStyle(styles);
        } else {
            const tag = document.createElement('style');
            tag.textContent = styles;
            document.head.appendChild(tag);
        }

        const trigger = document.createElement('div');
        trigger.id = 'df-floating-trigger';
        trigger.innerHTML = `<span>⚡</span><span>DF TOOL 1.4</span>`;

        const dashboard = document.createElement('div');
        dashboard.id = 'df-dashboard-v3';
        dashboard.innerHTML = `
            <div class="df-header">
                <div class="df-title">
                    <span>🎮 Delta Force Redeem</span>
                    <span class="df-badge-ver" id="df-ver-tag">v1.4 Offline</span>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="cursor:pointer; font-size:16px; color:#888;" id="df-btn-close">✕</span>
                </div>
            </div>
            <div class="df-body">
                <div class="df-auth-banner" id="df-auth-box">
                    <span id="df-auth-text">🔴 Đang kiểm tra đăng nhập...</span>
                    <span id="df-auth-sub" style="font-size:10px; opacity:0.8;"></span>
                </div>

                <div class="df-stats-grid">
                    <div class="df-stat-card">
                        <div class="df-stat-val" id="stat-total" style="color: var(--df-info)">0</div>
                        <div class="df-stat-lbl">Tổng mã</div>
                    </div>
                    <div class="df-stat-card">
                        <div class="df-stat-val" id="stat-success" style="color: var(--df-success)">0</div>
                        <div class="df-stat-lbl">Thành công</div>
                    </div>
                    <div class="df-stat-card">
                        <div class="df-stat-val" id="stat-used" style="color: var(--df-warn)">0</div>
                        <div class="df-stat-lbl">Đã nhận</div>
                    </div>
                    <div class="df-stat-card">
                        <div class="df-stat-val" id="stat-failed" style="color: var(--df-danger)">0</div>
                        <div class="df-stat-lbl">Thất bại</div>
                    </div>
                </div>

                <div class="df-progress-wrap">
                    <div class="df-progress-bar" id="df-progress-bar"></div>
                </div>

                <div class="df-setting-row">
                    <span>Tốc độ thực thi:</span>
                    <select id="df-speed-opt" class="df-select">
                        <option value="0.75">x0.75 (Chậm)</option>
                        <option value="1.0">x1.0 (Chuẩn)</option>
                        <option value="1.5">x1.5 (Vừa)</option>
                        <option value="2.0" selected>x2.0 (Nhanh)</option>
                        <option value="3.0">x3.0 (Siêu tốc)</option>
                        <option value="4.0">x4.0 (Cực hạn)</option>
                    </select>
                </div>

                <textarea id="df-code-input" placeholder="Dán danh sách code (dòng hoặc dấu cách)..."></textarea>

                <div class="df-actions">
                    <button class="df-btn df-btn-primary" id="btn-start">Bắt đầu chạy</button>
                    <button class="df-btn df-btn-warn" id="btn-pause">Tạm dừng</button>
                    <button class="df-btn df-btn-danger" id="btn-stop">Dừng hẳn</button>
                </div>

                <div id="df-logs-panel"></div>
            </div>
        `;

        document.body.appendChild(trigger);
        document.body.appendChild(dashboard);

        trigger.addEventListener('click', () => {
            dashboard.style.display = (dashboard.style.display === 'flex' ? 'none' : 'flex');
            checkLoginState();
        });
        document.getElementById('df-btn-close').addEventListener('click', () => {
            dashboard.style.display = 'none';
        });

        document.getElementById('btn-start').addEventListener('click', startEngine);
        document.getElementById('btn-pause').addEventListener('click', () => {
            if (State.status === 'RUNNING') {
                State.status = 'PAUSED';
                document.getElementById('btn-pause').innerText = 'Tiếp tục';
                log('Đã tạm dừng tiến trình', 'warn');
            } else if (State.status === 'PAUSED') {
                State.status = 'RUNNING';
                document.getElementById('btn-pause').innerText = 'Tạm dừng';
                log('Tiếp tục tiến trình', 'info');
            }
        });
        document.getElementById('btn-stop').addEventListener('click', () => {
            State.status = 'STOPPED';
            log('Đã hủy tiến trình', 'danger');
            resetControls();
        });

        setInterval(checkLoginState, 2000);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initUI);
    } else {
        initUI();
    }

    function checkLoginState() {
        const dashboard = document.getElementById('df-dashboard-v3');
        const elements = Array.from(document.querySelectorAll('a, button, div, span, p'))
            .filter(el => !(dashboard && dashboard.contains(el)) && el.offsetParent !== null);

        const hasLoginText = elements.some(el => {
            const txt = (el.innerText || el.textContent || '').trim().toLowerCase();
            return txt === 'đăng nhập' || txt === 'login' || txt === 'sign in';
        });

        const hasLogoutText = elements.some(el => {
            const txt = (el.innerText || el.textContent || '').trim().toLowerCase();
            return txt === 'đăng xuất' || txt === 'logout' || txt === 'thoát';
        });

        const roleElements = elements.filter(el => {
            const txt = (el.innerText || el.textContent || '').trim();
            return /nhân vật:|server:|uid:|role:|máy chủ:/i.test(txt);
        });

        if (roleElements.length > 0) {
            authData.isLoggedIn = true;
            if (!authData.roleName) {
                authData.roleName = roleElements[0].innerText.replace(/\n/g, ' ').trim();
            }
        } else if (hasLogoutText) {
            authData.isLoggedIn = true;
        } else if (hasLoginText && !authData.openid) {
            authData.isLoggedIn = false;
        }

        const input = locateInputTarget();
        if (input && !hasLoginText) {
            authData.isLoggedIn = true;
        }

        updateAuthUI();
        return authData.isLoggedIn;
    }

    function updateAuthUI() {
        const box = document.getElementById('df-auth-box');
        const txt = document.getElementById('df-auth-text');
        const sub = document.getElementById('df-auth-sub');
        if (!box || !txt) return;

        if (authData.isLoggedIn) {
            box.className = 'df-auth-banner df-logged';
            txt.innerText = '🟢 Đã đăng nhập game';
            sub.innerText = authData.roleName ? `(${authData.roleName.substring(0, 18)})` : (authData.openid ? `(ID: ${authData.openid.slice(-6)})` : '');
        } else {
            box.className = 'df-auth-banner';
            txt.innerText = '🔴 Chưa đăng nhập tài khoản';
            sub.innerText = 'Hãy đăng nhập trước';
        }
    }

    function log(message, type = 'info') {
        const logsContainer = document.getElementById('df-logs-panel');
        if (!logsContainer) return;
        const entry = document.createElement('div');
        entry.className = 'df-log-entry';
        const now = new Date();
        const timeStr = `${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
        entry.innerHTML = `<span class="df-log-time">[${timeStr}]</span><span class="df-log-txt df-log-${type}">${message}</span>`;
        logsContainer.appendChild(entry);
        logsContainer.scrollTop = logsContainer.scrollHeight;
    }

    function updateStatsUI() {
        const elTotal = document.getElementById('stat-total');
        const elSuccess = document.getElementById('stat-success');
        const elUsed = document.getElementById('stat-used');
        const elFailed = document.getElementById('stat-failed');
        const elProgress = document.getElementById('df-progress-bar');

        if (elTotal) elTotal.textContent = String(State.stats.total);
        if (elSuccess) elSuccess.textContent = String(State.stats.success);
        if (elUsed) elUsed.textContent = String(State.stats.used);
        if (elFailed) elFailed.textContent = String(State.stats.invalid + State.stats.failed);

        if (elProgress && State.stats.total > 0) {
            const progressPercent = Math.min(100, Math.round((State.currentIndex / State.stats.total) * 100));
            elProgress.style.width = `${progressPercent}%`;
        }

        // Force DOM redraw cho Safari/iOS
        if (elSuccess) void elSuccess.offsetHeight;
        if (elFailed) void elFailed.offsetHeight;
    }

    const sleep = (ms) => new Promise(r => setTimeout(r, ms));

    function injectInputValue(inputEl, value) {
        inputEl.focus();
        inputEl.value = value;
        const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value")?.set;
        if (nativeSetter) {
            nativeSetter.call(inputEl, value);
        }
        inputEl.dispatchEvent(new Event('input', { bubbles: true }));
        inputEl.dispatchEvent(new Event('change', { bubbles: true }));
        inputEl.dispatchEvent(new KeyboardEvent('keydown', { bubbles: true }));
        inputEl.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
    }

    function locateInputTarget() {
        const dashboard = document.getElementById('df-dashboard-v3');
        const list = Array.from(document.querySelectorAll('input[type="text"], input:not([type])'))
            .filter(el => !(dashboard && dashboard.contains(el)) && el.offsetParent !== null);

        let target = list.find(el => {
            const str = (el.placeholder + ' ' + el.id + ' ' + el.name + ' ' + el.className).toLowerCase();
            return str.includes('cdk') || str.includes('code') || str.includes('mã') || str.includes('nhập');
        });
        return target || (list.length > 0 ? list[list.length - 1] : null);
    }

    function locateSubmitTarget() {
        const dashboard = document.getElementById('df-dashboard-v3');
        const buttons = Array.from(document.querySelectorAll('button, div[role="button"], a, [class*="btn"], [class*="button"], [class*="submit"]'))
            .filter(b => !(dashboard && dashboard.contains(b)) && b.offsetParent !== null);

        return buttons.find(b => {
            const txt = (b.innerText || b.textContent || '').trim().toLowerCase();
            return txt.includes('đổi') || txt.includes('xác nhận') || txt.includes('nhận') || txt.includes('redeem') || txt.includes('exchange') || txt.includes('confirm');
        });
    }

    function parseApiResponse(json) {
        if (!json) return null;
        const code = json.code;
        const msg = json.msg || '';

        if (code === 0) {
            return { type: 'success', text: msg || 'Đổi thành công' };
        }
        // Bao gồm mã lỗi 400067, 400065, 400066 là đã nhận
        if (code === 400067 || code === 400065 || code === 400066 || /limit|reached|đã nhận|đã đổi|already/i.test(msg)) {
            return { type: 'used', text: msg || 'Đã đạt giới hạn nhóm code (Đã nhận)' };
        }
        // Lỗi mất token 400006, 400001, 400003
        if (code === 400001 || code === 400003 || code === 400006 || /token|login|đăng nhập/i.test(msg)) {
            authData.isLoggedIn = false;
            updateAuthUI();
            return { type: 'failed', text: 'Phiên đăng nhập hết hạn! Hãy đăng nhập lại' };
        }
        return { type: 'invalid', text: msg || `Lỗi (${code})` };
    }

    function classifyMessage(text) {
        const lower = text.toLowerCase();
        if (/thành công|chúc mừng|congratulations|success/i.test(lower)) {
            return { type: 'success', text };
        }
        if (/đã sử dụng|đã nhận|đã đổi|already|limit|reached|giới hạn/i.test(lower)) {
            return { type: 'used', text };
        }
        if (/đăng nhập|login|hết hạn phiên/i.test(lower)) {
            authData.isLoggedIn = false;
            updateAuthUI();
            return { type: 'failed', text };
        }
        return { type: 'invalid', text };
    }

    function dismissAnyPopup() {
        const dashboard = document.getElementById('df-dashboard-v3');
        const popups = Array.from(document.querySelectorAll('.van-dialog, .van-toast, .van-popup, .modal, .dialog, .popup, div[role="dialog"]'))
            .filter(el => !(dashboard && dashboard.contains(el)) && el.getBoundingClientRect().width > 0);

        for (const p of popups) {
            const closeBtn = Array.from(p.querySelectorAll('button, div[role="button"], span, a'))
                .find(b => /ok|xác nhận|confirm|đóng|close|biết rồi/i.test((b.innerText || b.textContent || '').toLowerCase()));
            if (closeBtn) closeBtn.click();
        }
    }

    function awaitRedeemResult(speed) {
        return new Promise((resolve) => {
            const timeoutMs = Math.max(900, Math.round(3500 / speed));
            let resolved = false;
            lastApiResponse = null;

            const onApiEvent = (e) => {
                if (!resolved && e.detail) {
                    resolved = true;
                    cleanup();
                    dismissAnyPopup();
                    resolve(parseApiResponse(e.detail));
                }
            };
            window.addEventListener('df_redeem_event', onApiEvent, { once: true });

            const timer = setTimeout(() => {
                if (!resolved) {
                    resolved = true;
                    cleanup();
                    if (lastApiResponse) {
                        resolve(parseApiResponse(lastApiResponse));
                    } else {
                        resolve({ type: 'failed', text: 'Quá thời gian phản hồi' });
                    }
                }
            }, timeoutMs);

            function checkDOMPopups() {
                const dashboard = document.getElementById('df-dashboard-v3');
                const popups = Array.from(document.querySelectorAll('.van-dialog, .van-toast, .van-popup, .modal, .dialog, .popup, div[role="dialog"], [class*="modal"], [class*="dialog"], [class*="popup"], [class*="toast"], [class*="notice"], [class*="alert"]'))
                    .filter(el => !(dashboard && dashboard.contains(el)) && el.getBoundingClientRect().width > 0 && window.getComputedStyle(el).display !== 'none');

                for (const p of popups) {
                    const txt = (p.innerText || p.textContent || "").trim();
                    if (txt.length > 2) {
                        const closeBtn = Array.from(p.querySelectorAll('button, div[role="button"], span, a'))
                            .find(b => /ok|xác nhận|confirm|đóng|close|biết rồi/i.test((b.innerText || b.textContent || '').toLowerCase()));
                        if (closeBtn) closeBtn.click();

                        const firstLine = txt.split('\n').filter(t => t.trim().length > 0)[0];
                        return classifyMessage(firstLine);
                    }
                }
                return null;
            }

            const observer = new MutationObserver(() => {
                const res = checkDOMPopups();
                if (res && !resolved) {
                    resolved = true;
                    cleanup();
                    resolve(res);
                }
            });

            observer.observe(document.body, { childList: true, subtree: true });

            function cleanup() {
                clearTimeout(timer);
                observer.disconnect();
                window.removeEventListener('df_redeem_event', onApiEvent);
            }
        });
    }

    async function startEngine() {
        const isLogged = checkLoginState();
        if (!isLogged) {
            log('❌ Bạn chưa đăng nhập tài khoản Delta Force!', 'danger');
            log('👉 Hãy bấm "Đăng nhập" trên web trước khi chạy.', 'warn');
            return;
        }

        const rawText = document.getElementById('df-code-input').value;
        const speed = parseFloat(document.getElementById('df-speed-opt').value) || 2.0;
        State.speedMultiplier = speed;

        // Tách code linh hoạt: xuống dòng, dấu phẩy, khoảng trắng
        const tokens = rawText.split(/[\s,]+/)
            .map(c => c.trim())
            .filter(c => c.length >= 4);

        const uniqueCodes = [...new Set(tokens)];

        if (uniqueCodes.length === 0) {
            log('Danh sách mã trống hoặc không hợp lệ!', 'warn');
            return;
        }

        const inputEl = locateInputTarget();
        if (!inputEl) {
            log('Không tìm thấy ô nhập code! Hãy chọn Server/Nhân vật trước.', 'danger');
            return;
        }

        State.queue = uniqueCodes;
        State.currentIndex = 0;
        State.stats = { total: uniqueCodes.length, success: 0, used: 0, invalid: 0, failed: 0 };
        State.status = 'RUNNING';
        updateStatsUI();

        document.getElementById('btn-start').style.display = 'none';
        document.getElementById('btn-pause').style.display = 'block';
        document.getElementById('btn-stop').style.display = 'block';
        log(`Khởi chạy v1.4 Offline: ${uniqueCodes.length} mã (Tốc độ x${speed})`, 'info');

        const inputDelay = Math.max(60, Math.round(250 / speed));
        const postDelay = Math.max(200, Math.round(800 / speed));

        while (State.currentIndex < State.queue.length) {
            if (State.status === 'STOPPED') break;

            if (State.status === 'PAUSED') {
                await sleep(300);
                continue;
            }

            const currentCode = State.queue[State.currentIndex];
            log(`[${State.currentIndex + 1}/${State.queue.length}] Gửi: ${currentCode}...`, 'info');

            const currentInput = locateInputTarget();
            if (currentInput) {
                injectInputValue(currentInput, currentCode);
            }

            await sleep(inputDelay);

            const submitBtn = locateSubmitTarget();
            if (submitBtn) {
                submitBtn.click();
                const res = await awaitRedeemResult(speed);

                if (res.type === 'success') {
                    State.stats.success++;
                    log(`✔ [${currentCode}]: ${res.text}`, 'success');
                } else if (res.type === 'used') {
                    State.stats.used++;
                    log(`⚡ [${currentCode}]: ${res.text}`, 'warn');
                } else {
                    State.stats.invalid++;
                    log(`✖ [${currentCode}]: ${res.text}`, 'danger');
                }

                if (!authData.isLoggedIn) {
                    log('⚠ Phát hiện mất phiên đăng nhập! Tiến trình dừng lại.', 'danger');
                    break;
                }
            } else {
                State.stats.failed++;
                log(`✖ [${currentCode}]: Không thấy nút Đổi`, 'danger');
            }

            State.currentIndex++;
            updateStatsUI();

            await sleep(postDelay);
        }

        if (State.status !== 'STOPPED') {
            log(`Kết thúc! Thành công: ${State.stats.success} | Đã dùng: ${State.stats.used} | Thất bại: ${State.stats.invalid + State.stats.failed}`, 'success');
        }
        resetControls();
    }

    function resetControls() {
        State.status = 'IDLE';
        const btnStart = document.getElementById('btn-start');
        if (btnStart) {
            btnStart.style.display = 'block';
            btnStart.innerText = 'Chạy lại';
        }
        const btnPause = document.getElementById('btn-pause');
        if (btnPause) btnPause.style.display = 'none';
        const btnStop = document.getElementById('btn-stop');
        if (btnStop) btnStop.style.display = 'none';
    }

})();
