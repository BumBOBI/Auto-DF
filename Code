// ==UserScript==
// @name         Delta Force Garena Auto Redeem (iOS - Speed Selector)
// @namespace    https://staybrowser.com/
// @version      1.0
// @description  Tự động nhập code Delta Force Garena trên iOS với tùy chọn tốc độ x0.75 - x4
// @author       LHyuz
// @match        *://redeem.df.garena.sg/*
// @grant        GM_addStyle
// @run-at       document-idle
// ==/UserScript==

(function() {
    'use strict';

    const css = `
        #df-redeem-btn {
            position: fixed;
            bottom: 25px;
            right: 15px;
            z-index: 999999;
            background: #ff5722;
            color: #fff;
            padding: 12px 16px;
            border-radius: 50px;
            font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 14px;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);
            border: none;
        }
        #df-redeem-panel {
            position: fixed;
            bottom: 80px;
            right: 15px;
            width: 320px;
            max-width: 90vw;
            background: #1e1e24;
            border: 1px solid #333;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.6);
            padding: 14px;
            z-index: 999999;
            display: none;
            font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            color: #fff;
        }
        #df-counter-box {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            margin-bottom: 8px;
            text-align: center;
        }
        .counter-badge {
            background: #2b2b36;
            padding: 6px 4px;
            border-radius: 6px;
            border: 1px solid #3d3d4e;
        }
        .counter-val {
            font-size: 16px;
            font-weight: bold;
        }
        .counter-title {
            font-size: 10px;
            color: #aaa;
            text-transform: uppercase;
        }
        .speed-control {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 13px;
            background: #2b2b36;
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #3d3d4e;
        }
        .speed-control select {
            background: #1e1e24;
            color: #ff9800;
            border: 1px solid #555;
            border-radius: 4px;
            padding: 4px 8px;
            font-weight: bold;
            font-size: 13px;
            outline: none;
        }
        #df-redeem-panel textarea {
            width: 100%;
            height: 75px;
            box-sizing: border-box;
            background: #2b2b36;
            color: #fff;
            border: 1px solid #444;
            border-radius: 6px;
            padding: 8px;
            font-size: 12px;
            resize: none;
            margin: 4px 0 6px 0;
        }
        #df-redeem-panel button.action-btn {
            width: 100%;
            background: #ff5722;
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
        }
        #df-redeem-logs {
            font-size: 12px;
            margin-top: 8px;
            max-height: 100px;
            overflow-y: auto;
            border: 1px solid #333;
            border-radius: 6px;
            padding: 6px;
            background: #141419;
        }
        .log-item { margin-bottom: 3px; line-height: 1.3; }
        .log-success { color: #2ecc71; font-weight: bold; }
        .log-error { color: #e74c3c; font-weight: bold; }
        .log-info { color: #3498db; }
    `;

    if (typeof GM_addStyle !== "undefined") {
        GM_addStyle(css);
    } else {
        const style = document.createElement('style');
        style.textContent = css;
        document.head.appendChild(style);
    }

    const triggerBtn = document.createElement('button');
    triggerBtn.id = 'df-redeem-btn';
    triggerBtn.innerText = '⚙️ Nhập Code DF';

    const panel = document.createElement('div');
    panel.id = 'df-redeem-panel';
    panel.innerHTML = `
        <div style="font-weight: bold; font-size: 14px; margin-bottom: 8px; color: #ff5722;">Delta Force Code Tool</div>
        <div id="df-counter-box">
            <div class="counter-badge">
                <div class="counter-val" id="cnt-progress" style="color: #3498db;">0/0</div>
                <div class="counter-title">Tiến trình</div>
            </div>
            <div class="counter-badge">
                <div class="counter-val" id="cnt-success" style="color: #2ecc71;">0</div>
                <div class="counter-title">Thành công</div>
            </div>
            <div class="counter-badge">
                <div class="counter-val" id="cnt-failed" style="color: #e74c3c;">0</div>
                <div class="counter-title">Thất bại</div>
            </div>
        </div>
        <div class="speed-control">
            <span>Tốc độ thực thi:</span>
            <select id="df-speed-select">
                <option value="0.75">x0.75 (Chậm / An toàn)</option>
                <option value="1" selected>x1 (Mặc định)</option>
                <option value="1.5">x1.5 (Nhanh vừa)</option>
                <option value="2">x2 (Nhanh gấp đôi)</option>
                <option value="3">x3 (Siêu tốc)</option>
                <option value="4">x4 (Cực hạn)</option>
            </select>
        </div>
        <textarea id="df-code-input" placeholder="Dán danh sách mã code vào đây..."></textarea>
        <button class="action-btn" id="df-start-btn">Bắt đầu Redeem</button>
        <div id="df-redeem-logs">
            <div class="log-item log-info">Hệ thống đã sẵn sàng!</div>
        </div>
    `;

    document.body.appendChild(triggerBtn);
    document.body.appendChild(panel);

    triggerBtn.addEventListener('click', () => {
        panel.style.display = (panel.style.display === 'none' || panel.style.display === '') ? 'block' : 'none';
    });

    const addLog = (text, type = 'info') => {
        const logBox = document.getElementById('df-redeem-logs');
        if (!logBox) return;
        const div = document.createElement('div');
        div.className = `log-item log-${type}`;
        div.innerText = text;
        logBox.appendChild(div);
        logBox.scrollTop = logBox.scrollHeight;
    };

    const sleep = (ms) => new Promise(r => setTimeout(r, ms));

    const setInputValue = (input, val) => {
        input.focus();
        const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
        nativeSetter.call(input, val);
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        input.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
    };

    function getCDKInput() {
        const inputs = Array.from(document.querySelectorAll('input[type="text"], input:not([type])'))
            .filter(el => !panel.contains(el) && el.offsetParent !== null);

        let cdkInput = inputs.find(el => {
            const attr = (el.placeholder + ' ' + el.id + ' ' + el.name + ' ' + el.className).toLowerCase();
            return attr.includes('cdk') || attr.includes('code') || attr.includes('mã') || attr.includes('quà');
        });

        return cdkInput || (inputs.length > 0 ? inputs[inputs.length - 1] : null);
    }

    function getSubmitButton() {
        const buttons = Array.from(document.querySelectorAll('button, div[role="button"], a, [class*="btn"]'))
            .filter(b => !panel.contains(b) && b.offsetParent !== null);

        return buttons.find(b => {
            const txt = (b.innerText || b.textContent || '').trim().toLowerCase();
            return txt === 'đổi' || txt === 'xác nhận' || txt === 'nhận' || txt === 'redeem' || txt === 'exchange' || txt === 'confirm';
        });
    }

    // Thời gian quét và timeout phản hồi dựa theo hệ số tốc độ
    const inspectResponse = async (speedMultiplier) => {
        const timeout = Math.max(800, Math.round(4500 / speedMultiplier));
        const checkInterval = Math.max(50, Math.round(300 / speedMultiplier));
        const startTime = Date.now();

        while (Date.now() - startTime < timeout) {
            const popups = Array.from(document.querySelectorAll('.van-dialog, .van-toast, .modal, .dialog, .popup, div[role="dialog"], [class*="notice"], [class*="alert"]'))
                .filter(el => !panel.contains(el) && el.getBoundingClientRect().width > 0 && window.getComputedStyle(el).display !== 'none');

            for (const pop of popups) {
                const text = (pop.innerText || pop.textContent || "").trim();
                if (text.length > 2) {
                    let isSuccess = /thành công|chúc mừng|success|congratulations/i.test(text);

                    const closeBtn = Array.from(pop.querySelectorAll('button, div[role="button"], span'))
                        .find(b => /ok|xác nhận|confirm|đóng|close/i.test((b.innerText || '').toLowerCase()));
                    if (closeBtn) closeBtn.click();

                    const cleanMsg = text.split('\n').filter(t => t.trim().length > 0)[0];
                    return isSuccess ? { status: 'success', msg: cleanMsg } : { status: 'error', msg: cleanMsg };
                }
            }
            await sleep(checkInterval);
        }
        return { status: 'error', msg: 'Hết thời gian chờ / Bỏ qua' };
    };

    function updateCounterView(success, failed, current, total) {
        const elProgress = document.getElementById('cnt-progress');
        const elSuccess = document.getElementById('cnt-success');
        const elFailed = document.getElementById('cnt-failed');

        elProgress.textContent = `${current}/${total}`;
        elSuccess.textContent = String(success);
        elFailed.textContent = String(failed);

        void elSuccess.offsetHeight;
        void elFailed.offsetHeight;
    }

    async function runBatch() {
        const textarea = document.getElementById('df-code-input');
        const list = textarea.value.split('\n').map(c => c.trim()).filter(c => c.length >= 4);

        if (list.length === 0) {
            addLog('⚠️ Vui lòng dán code vào ô!', 'error');
            return;
        }

        const inputField = getCDKInput();
        if (!inputField) {
            addLog('❌ Không tìm thấy ô nhập! Hãy chọn Server/Nhân vật trước.', 'error');
            return;
        }

        const speedSelect = document.getElementById('df-speed-select');
        const speed = parseFloat(speedSelect.value) || 1;

        // Các mốc cơ bản (mặc định gốc an toàn)
        // inputDelay gốc: 600ms, pauseDelay gốc: 1800ms
        const inputDelay = Math.max(80, Math.round(650 / speed));
        const pauseDelay = Math.max(250, Math.round(1900 / speed));

        const startBtn = document.getElementById('df-start-btn');
        let successCount = 0;
        let failCount = 0;

        updateCounterView(0, 0, 0, list.length);

        startBtn.disabled = true;
        speedSelect.disabled = true;
        startBtn.innerText = `Đang chạy (x${speed})...`;

        for (let i = 0; i < list.length; i++) {
            const code = list[i];
            addLog(`[${i + 1}/${list.length}] Đang gửi: ${code}...`, 'info');

            const currentInput = getCDKInput();
            if (currentInput) {
                setInputValue(currentInput, code);
            }

            await sleep(inputDelay);

            const submitBtn = getSubmitButton();
            if (submitBtn) {
                submitBtn.click();
                const res = await inspectResponse(speed);
                addLog(`➜ ${code}: ${res.msg}`, res.status);

                if (res.status === 'success') {
                    successCount++;
                } else {
                    failCount++;
                }
            } else {
                addLog(`➜ ${code}: Không tìm thấy nút Đổi!`, 'error');
                failCount++;
            }

            updateCounterView(successCount, failCount, i + 1, list.length);

            await sleep(pauseDelay);
        }

        addLog(`🏁 Xong! Thành công: ${successCount} | Thất bại: ${failCount}`, 'success');
        startBtn.disabled = false;
        speedSelect.disabled = false;
        startBtn.innerText = 'Bắt đầu Redeem';
    }

    document.getElementById('df-start-btn').addEventListener('click', runBatch);
})();
